#!/usr/bin/env python3
"""Para el atajo Alt + Shift derecho: abre Ío en su propia terminal, o avisa si ya está abierto.

Wayland no deja traer al frente la ventana de otro programa, así que si Ío ya está en
marcha solo lo dice en voz alta y con una notificación.
"""

import fcntl
import shutil
import subprocess
import sys
from pathlib import Path

RAIZ = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(RAIZ / "scripts"))
from comun import IO_LOCK, RUNTIME, enviar_arrancando  # noqa: E402


def en_marcha() -> bool:
    RUNTIME.mkdir(parents=True, exist_ok=True)
    try:
        with open(IO_LOCK, "a") as f:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
            fcntl.flock(f, fcntl.LOCK_UN)
        return False
    except BlockingIOError:
        return True


def main() -> int:
    if en_marcha():
        try:
            enviar_arrancando({"cmd": "decir", "texto": "Ya estoy aquí, en mi ventana."})
        except OSError:
            pass
        if shutil.which("notify-send"):
            subprocess.run(["notify-send", "-a", "Ío", "Ío ya está abierto", "Búscalo en la terminal «Ío»."])
        return 0
    terminal = shutil.which("gnome-terminal")
    if not terminal:
        return 1
    subprocess.Popen([terminal, "--title=Ío", f"--working-directory={Path.home() / 'Documentos'}", "--",
                      sys.executable, str(RAIZ / "bin" / "io")],
                     start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return 0


if __name__ == "__main__":
    sys.exit(main())
