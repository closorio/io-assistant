#!/usr/bin/env python3
"""Control del narrador de voz.

  narrador estado | silencio | activar | saltar | vaciar | prueba | parar | voces
  narrador decir TEXTO...
  narrador motor edge|piper|spd
  narrador voz NOMBRE        (voz de Piper instalada en ~/.local/share/narrador/voces)
  narrador velocidad N       (Piper: 0.5–2.0 · spd: -100..100)
  narrador salidas           (salidas de audio; * la que usa la voz)
  narrador salida TEXTO|defecto   (p. ej. «narrador salida hyperx» para oírla en los cascos)
  narrador sesiones [--vivas|--todas]   (de este proyecto · abiertas ahora · recientes de todos)
  narrador seguir [ID]       (visor: un resumen por turno de esa sesión, de cualquier proyecto)
  narrador escuchar [--dueño io|mentor]   (oído: entrega lo que le dices a Ío; lo usa Monitor)
  narrador escucha [estado|pausa|activar|alternar|parar]
  narrador proyectos [--todos] [--git]
  narrador trabajador lanzar PROYECTO "TAREA" [--modelo opus] | lista | abrir NOMBRE
  narrador recordar MINUTOS TEXTO
  narrador guia [TEMA]       (guías de Ío: sesiones, proyectos, escritorio, personal, mentor)
"""

import json
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "scripts"))
from comun import (  # noqa: E402
    VOCES, enviar, enviar_arrancando, guardar_config, leer_config,
)
from visor import listar, listar_todas, seguir  # noqa: E402
import asistente  # noqa: E402
import escucha  # noqa: E402

PRUEBA = "¡Buenas! Soy Ío. Si me estás oyendo, la voz funciona."


def recargar() -> None:
    try:
        enviar({"cmd": "recargar"})
    except OSError:
        pass  # sin daemon: leerá config.json al arrancar


def cambiar(mutar, mensaje: str) -> None:
    cfg = leer_config()
    mutar(cfg)
    guardar_config(cfg)
    recargar()
    print(mensaje)


def estado() -> None:
    cfg = leer_config()
    try:
        e = enviar({"cmd": "estado"}, esperar_respuesta=True)
        print(f"daemon en marcha (pid {e['pid']}) · motor {e['motor']} · "
              f"silencio {'sí' if e['silencio'] else 'no'} · en cola {e['en_cola']} · "
              f"hablando {'sí' if e['hablando'] else 'no'}")
    except OSError:
        print(f"daemon parado (arranca solo con la primera frase) · motor {cfg['motor']} · "
              f"silencio {'sí' if cfg['silencio'] else 'no'}")
    m = cfg["motor"]
    if m == "edge":
        print(f"edge: voz {cfg['edge']['voz']} · velocidad {cfg['edge']['velocidad']}%")
    elif m == "piper":
        print(f"piper: voz {cfg['piper']['voz']} · velocidad {cfg['piper']['velocidad']}")
    else:
        print(f"spd: idioma {cfg['spd']['idioma']} · velocidad {cfg['spd']['velocidad']}")


def voz(nombre: str) -> None:
    if leer_config()["motor"] == "edge":
        cambiar(lambda c: c["edge"].update(voz=nombre), f"voz de Edge: {nombre}")
        return
    if not (VOCES / f"{nombre}.onnx").exists():
        sys.exit(f"voz no instalada: {nombre}. Instaladas: {', '.join(voces_instaladas()) or 'ninguna'}"
                 f" (instala más con scripts/instalar.sh NOMBRE)")
    cambiar(lambda c: (c["piper"].update(voz=nombre), c["piper"].pop("hablante", None)), f"voz de Piper: {nombre}")


def velocidad(valor: str) -> None:
    m = leer_config()["motor"]
    if m == "edge":
        v = max(-50, min(int(valor), 100))
        cambiar(lambda c: c["edge"].update(velocidad=v), f"velocidad de Edge: {v}%")
    elif m == "spd":
        v = max(-100, min(int(valor), 100))
        cambiar(lambda c: c["spd"].update(velocidad=v), f"velocidad de spd: {v}")
    else:
        v = max(0.5, min(float(valor), 2.0))
        cambiar(lambda c: c["piper"].update(velocidad=v), f"velocidad de Piper: {v}")


def voces_instaladas() -> list[str]:
    return sorted(p.stem for p in VOCES.glob("*.onnx"))


def salidas_audio() -> list[tuple[str, str]]:
    """(node.name, descripción) de cada salida de audio de PipeWire."""
    nodos = json.loads(subprocess.run(["pw-dump"], capture_output=True, text=True, check=True).stdout)
    lista = []
    for nodo in nodos:
        props = (nodo.get("info") or {}).get("props") or {}
        if props.get("media.class") == "Audio/Sink":
            lista.append((props.get("node.name", ""), props.get("node.description", "")))
    return lista


def salidas() -> None:
    actual = leer_config().get("destino")
    for nombre, descripcion in salidas_audio():
        print(f"{'*' if nombre == actual else ' '} {descripcion}  ({nombre})")
    if not actual:
        print("la voz usa la salida por defecto del sistema")


def salida(texto: str) -> None:
    if texto == "defecto":
        cambiar(lambda c: c.update(destino=None), "la voz usa la salida por defecto del sistema")
        return
    encontradas = [s for s in salidas_audio() if texto.lower() in (s[0] + " " + s[1]).lower()]
    if len(encontradas) != 1:
        sys.exit(f"«{texto}» coincide con {len(encontradas)} salidas; mira «narrador salidas»")
    nombre, descripcion = encontradas[0]
    cambiar(lambda c: c.update(destino=nombre), f"la voz sale por: {descripcion}")


def ordenar(orden: dict, mensaje: str) -> None:
    try:
        enviar(orden)
        print(mensaje)
    except OSError:
        print("el daemon no está en marcha")


def main(args: list[str]) -> None:
    if not args or args[0] in ("-h", "--help", "ayuda"):
        print(__doc__.strip())
        return
    cmd, resto = args[0], args[1:]
    if cmd == "estado":
        estado()
    elif cmd == "silencio":
        cambiar(lambda c: c.update(silencio=True), "narrador en silencio")
    elif cmd == "activar":
        cambiar(lambda c: c.update(silencio=False), "narrador activado")
    elif cmd == "saltar":
        ordenar({"cmd": "saltar"}, "frase saltada")
    elif cmd == "vaciar":
        ordenar({"cmd": "vaciar"}, "cola vaciada")
    elif cmd == "parar":
        ordenar({"cmd": "salir"}, "daemon parado")
    elif cmd in ("decir", "prueba"):
        texto = " ".join(resto) if cmd == "decir" else PRUEBA
        if not texto:
            sys.exit("uso: narrador decir TEXTO")
        if leer_config().get("silencio"):
            print("aviso: el narrador está en silencio (narrador activar)")
        enviar_arrancando({"cmd": "decir", "texto": texto}, espera=3.0)
        print("enviado")
    elif cmd == "motor" and resto and resto[0] in ("edge", "piper", "spd"):
        cambiar(lambda c: c.update(motor=resto[0]), f"motor: {resto[0]}")
    elif cmd == "voz" and resto:
        voz(resto[0])
    elif cmd == "velocidad" and resto:
        velocidad(resto[0])
    elif cmd == "voces":
        print("\n".join(voces_instaladas()) or "ninguna voz de Piper instalada")
    elif cmd == "sesiones":
        if "--vivas" in resto:
            asistente.vivas()
        elif "--todas" in resto:
            listar_todas()
        else:
            listar()
    elif cmd == "seguir":
        try:
            seguir(resto[0] if resto else None)
        except KeyboardInterrupt:
            pass
    elif cmd == "escuchar":
        dueno = resto[resto.index("--dueño") + 1] if "--dueño" in resto[:-1] else "mentor"
        try:
            escucha.escuchar(dueno)
        except KeyboardInterrupt:
            pass
    elif cmd == "escucha":
        escucha.main(resto)
    elif cmd == "salidas":
        salidas()
    elif cmd == "salida" and resto:
        salida(" ".join(resto))
    elif cmd == "proyectos":
        asistente.proyectos(todos="--todos" in resto, git="--git" in resto)
    elif cmd == "trabajador":
        asistente.trabajador(resto)
    elif cmd == "recordar" and len(resto) >= 2:
        asistente.recordar(resto[0], " ".join(resto[1:]))
    elif cmd == "aviso" and resto:
        asistente.aviso(" ".join(resto))
    elif cmd == "guia":
        asistente.guia(resto[0] if resto else None)
    else:
        sys.exit(__doc__.strip())


if __name__ == "__main__":
    main(sys.argv[1:])
